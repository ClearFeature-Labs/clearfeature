# FinTech Feature Platform — Compose environment.
# Copy to .env and adjust. NO real secrets here; replace the dev credentials before
# exposing anything beyond localhost. All host ports bind to 127.0.0.1 only.

# --- Postgres -----------------------------------------------------------------
POSTGRES_USER=fsp
POSTGRES_PASSWORD=fsp_dev_password
POSTGRES_DB=fsp
POSTGRES_PORT=5432
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_WORK_MEM=16MB
POSTGRES_MAINTENANCE_WORK_MEM=128MB

# --- Valkey (online feature store) ---------------------------------------------
VALKEY_PORT=6379
VALKEY_MAXMEMORY=512mb

# --- MinIO (raw payload storage) -----------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Redpanda (Kafka API) --------------------------------------------------------
# Host clients bootstrap at localhost:${REDPANDA_KAFKA_PORT}; containers ALWAYS use
# redpanda:19092 (the internal listener) — wired inside docker-compose.yml.
REDPANDA_KAFKA_PORT=19092
REDPANDA_SMP=1

# Topic provisioning : the one-shot kafka-init service creates the
# canonical fp.* topics before workers start. Grow-only (partitions never shrink).
# Production guidance: partitions ~= 2x worker ceiling; RF=3 only with >=3 brokers.
FSP_KAFKA_TOPIC_PARTITIONS=4
FSP_KAFKA_REPLICATION_FACTOR=1

# --- Application (api + workers) --------------------------------------------------
API_PORT=8000
FSP_MINIO_BUCKET=raw-reports

# Demo-only online scorer (; starts with `docker compose --profile demo up`)
MODEL_SERVICE_PORT=8090

# --- Security  ----------------------------------------------------------
# Fail-closed API-key auth. The api container refuses to start in api_key mode without
# keys. Generate every secret yourself (placeholders below are REJECTED at startup):
#   openssl rand -hex 32
# Roles: service (data-plane) | operator (superset: + observability/ingestion/batch).
# Full guide: docs/security/minimum_security.md
FSP_SECURITY_MODE=api_key
FSP_ENVIRONMENT=development
#FSP_API_KEYS=[{"key_id":"ops-local-1","role":"operator","secret":"REPLACE_WITH_openssl_rand_hex_32"},{"key_id":"svc-model-1","role":"service","secret":"REPLACE_WITH_ANOTHER_openssl_rand_hex_32"}]
# demo-model-service: its OWN accepted client keys + its OWN upstream service key
# (FSP_FEATURE_API_KEY must be the secret of a service-role key listed in FSP_API_KEYS).
#FSP_MODEL_SERVICE_API_KEYS=[{"key_id":"svc-decision-client-1","role":"service","secret":"REPLACE_WITH_openssl_rand_hex_32"}]
#FSP_FEATURE_API_KEY=REPLACE_WITH_THE_svc-model-1_SECRET
# Development-only bypass (never a pilot default):
#   FSP_SECURITY_MODE=disabled   (requires FSP_ENVIRONMENT=development)

# Registry seam : unset -> built-in demo registry. To serve the credit
# decision demo contract instead (scripts/run_credit_batch_demo.sh sets these):
#   FSP_REGISTRY_PATH=examples/credit_decision_demo/registry/credit_decision_v1.yaml
#   FSP_UDF_PROVIDER=examples.credit_decision_demo.features:build_registry_and_udfs

# Postgres pool size per process. Compose sets per-service
# budgets (api=10, writers/batch=4, others=2). 0 = legacy connection-per-operation
# (the rollback lever). Budget check: sum of pools must stay under POSTGRES_MAX_CONNECTIONS.
#   FSP_DB_POOL_SIZE=4

# In-container app settings (FSP_*) are set in docker-compose.yml to Docker-network
# addresses (postgres:5432, minio:9000, valkey:6379, redpanda:19092). For HOST-side
# tools (uv run uvicorn/pytest against the compose infra) use localhost instead:
#   FSP_BACKEND=local
#   FSP_EVENTS=kafka
#   FSP_POSTGRES_DSN=postgresql://fsp:fsp_dev_password@localhost:5432/fsp
#   FSP_MINIO_ENDPOINT=localhost:9000
#   FSP_VALKEY_HOST=localhost
#   FSP_KAFKA_BOOTSTRAP_SERVERS=localhost:19092
